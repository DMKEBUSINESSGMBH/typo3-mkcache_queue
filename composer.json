{
    "name" : "dmk/mkcache_queue",
    "description" : "Clear the TYPO3 caches via a queue instead of doing it directly",
    "type" : "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "cache",
        "queue",
        "performance"
    ],
    "homepage" : "http://www.dmk-ebusiness.de/",
    "license": "GPL-2.0-or-later",
    "authors" : [{
        "name" : "Hannes Bochmann",
        "email" : "dev@dmk-ebusiness.de",
        "role" : "Developer"
    }],
    "support": {
        "email": "dev@dmk-ebusiness.de",
        "source": "https://github.com/DMKEBUSINESSGMBH/typo3-mkcache_queue",
        "issues": "https://github.com/DMKEBUSINESSGMBH/typo3-mkcache_queue"
    },
    "repositories" : [
        {
            "type" : "vcs",
            "url" : "https://github.com/sat-hub/phpcpd.git"
        }
    ],
    "require" : {
        "typo3/cms-core": "^12.4 || ^13.4"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.10",
        "friendsofphp/php-cs-fixer": "^3.8",
        "helmich/typo3-typoscript-lint": "^3.1",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpcompatibility/php-compatibility": "^9.3",
        "typo3/testing-framework": "^8.0 || ^9.0",
        "phpmd/phpmd": "^2.14",
        "phpstan/extension-installer": "^1.1 || ^2.0",
        "phpstan/phpstan": "^1.1 || ^2.0",
        "rector/rector": "^1.0 || 2.0.10",
        "saschaegerer/phpstan-typo3": "^1.0 || ^2.0",
        "sat-hub/phpcpd": "^7.0",
        "ssch/typo3-rector": "^2.8 | ^3.1"
    },
    "autoload": {
        "psr-4": {
            "DMK\\MkcacheQueue\\" : "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DMK\\MkcacheQueue\\Tests\\": "Tests"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias" : {
            "dev-13.4": "13.0.x-dev"
        },
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "mkcache_queue",
            "web-dir": ".Build/Web",
            "app-dir": ".Build"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "[ -e .Build/bin/captainhook ] && .Build/bin/captainhook install -f || echo 'CaptainHook missing, skip install.'"
        ],
        "lint:php": [
            "[ -e .Build/bin/parallel-lint ] || composer update",
            "echo 'parallel-lint fails with a exception if executed inside the vendor/dmk/mkcache_queue folder'",
            "[ ! -e ../../autoload.php ] || mv ../../autoload.php ../../autoload.php.bak",
            ".Build/bin/parallel-lint ./*",
            "[ ! -e ../../autoload.php.bak ] || mv ../../autoload.php.bak ../../autoload.php"
        ],
        "lint:yaml": [
            "[ -e .Build/bin/yaml-lint ] || composer update",
            ".Build/bin/yaml-lint --ansi -n -v ./Configuration ./Resources"
        ],
        "lint": [
            "@lint:php",
            "@lint:yaml"
        ],
        "test:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update",
            "export PHP_CS_FIXER_IGNORE_ENV=1 && .Build/bin/php-cs-fixer fix -v --dry-run --diff"
        ],
        "test:rector": [
            "[ -e .Build/bin/rector ] || composer update",
            ".Build/bin/rector process --dry-run"
        ],
        "test:phpcompatibility": [
            "[ -e .Build/bin/phpcs ] || composer update",
            ".Build/bin/phpcs --ignore=.Build/*,Resources/Public/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.1-8.4"
        ],
        "test:phpmd": [
            "[ -e .Build/bin/phpmd ] || composer update",
            ".Build/bin/phpmd ./Classes text phpmd.xml"
        ],
        "test:phpstan": [
            "[ -e .Build/bin/phpstan ] || composer update",
            ".Build/bin/phpstan analyse -c phpstan.neon --memory-limit=512M"
        ],
        "test:phpcpd": [
            "[ -e .Build/bin/phpcpd ] || composer update",
            ".Build/bin/phpcpd Classes"
        ],
        "test:phpunit": [
            "[ -e .Build/bin/phpunit ] || composer update",
            "export TYPO3_PATH_APP=$PWD/.Build && export TYPO3_PATH_WEB=$PWD/.Build/Web && .Build/bin/phpunit -c .Build/vendor/typo3/testing-framework/Resources/Core/Build/UnitTests.xml Tests/"
        ],
        "test": [
            "@test:phpcs",
            "@test:rector",
            "@test:phpcompatibility",
            "@test:phpmd",
            "@test:phpstan",
            "@test:phpcpd",
            "@test:phpunit"
        ],
        "fix:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update",
            "export PHP_CS_FIXER_IGNORE_ENV=1 && .Build/bin/php-cs-fixer fix -v"
        ],
        "fix:rector": [
            "[ -e .Build/bin/rector ] || composer update",
            ".Build/bin/rector process"
        ],
        "fix": [
            "@fix:phpcs",
            "@fix:rector"
        ],
        "runqa": [
            "@fix",
            "@lint",
            "@test"
        ]
    }
}
